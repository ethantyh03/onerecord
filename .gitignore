# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local secrets / artifacts
.env*.local
.env
/test-results/
/playwright-report/
/recordings/raw/
__pycache__/
*.pyc
.venv/

# side-by-side builds (NEXT_DIST_DIR)
/.next-*/

# large video artefacts (the final video goes to YouTube; keep scripts + captions only)
/deliverables/video/*
!/deliverables/video/voiceover-script.md
!/deliverables/video/Tesseract-demo.srt

.vercel
.env*
/deliverables/video-nocap/

# internal working notes (kept locally, not published)
/STATUS.md
/docs/superpowers/
/deliverables/PRESENTER-GUIDE.*
/deliverables/guide-parts/

# Finals rehearsal clips (large, local only)
/deliverables/finals/clips/
